# 复制为 .env；两个 iPhone 工具会自动读取。环境变量优先。
# 使用简单 KEY=value；包含空格的路径加双引号，支持 $HOME。
IOS_UDID=
WDA_TEAM_ID=
WDA_PROJECT_DIR="$HOME/code/WebDriverAgent"
# 留空则使用 WDA_PROJECT_DIR/build
WDA_DERIVED_DATA=
# 安装到手机后的 Runner 包名，通常为你设置的 Bundle Identifier 加 .xctrunner。
# 用 ios.py apps WebDriverAgent 确认；clipboard 命令需要填写。
WDA_RUNNER_BUNDLE_ID=
WDA_LOCAL_PORT=8100
# 留空则使用 http://127.0.0.1:WDA_LOCAL_PORT；自建 WDA 可填其地址。
WDA_BASE_URL=
